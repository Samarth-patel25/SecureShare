@model SecureShare.Models.FileUploadViewModel

@{
    ViewData["Title"] = "Upload File";
}

<h2>Upload File</h2>
//enctype  is required when sending an actual file from the browser to ASP.NET Core.
<form asp-action="Upload" method="post" enctype="multipart/form-data">

    <div class="mb-3">
        <label asp-for="File" class="form-label">Choose File</label>
        <input asp-for="File" class="form-control" type="file" />
        <span asp-validation-for="File" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">
        Upload
    </button>

</form>