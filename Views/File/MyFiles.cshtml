@model IEnumerable<SecureShare.Models.File>

@{
    ViewData["Title"] = "My Files";
}

<div class="container mt-4">

    <h2>My Files</h2>

    @if (!Model.Any())
    {
        <p>You have not uploaded any files yet.</p>
    }
    else
    {
        <table class="table table-bordered table-striped mt-3">

            <thead>
                <tr>
                    <th>File Name</th>
                    <th>Size</th>
                    <th>Type</th>
                    <th>Uploaded At</th>
                    <th>Action</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var file in Model)
                {
                    <tr>
                        <td>
                            @file.OriginalFileName
                        </td>

                        <td>
                            @(Math.Round(file.FileSize / 1024.0, 2)) KB
                        </td>

                        <td>
                            @file.ContentType
                        </td>

                        <td>
                            @file.UploadedAt.ToLocalTime()
                        </td>

                        <td>
                            <a asp-controller="File"
                               asp-action="Download"
                               asp-route-id="@file.Id"
                               class="btn btn-primary">
                                Download
                            </a>
                        </td>
                    </tr>
                }
            </tbody>

        </table>
    }

</div>