@{
    ViewData["Title"] = "Home";
}

<div class="ss-hero mb-5">
    <div class="row align-items-center g-5">
        <div class="col-lg-7">
            <span class="ss-tag mb-3">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="11" width="16" height="10" rx="2" /><path d="M8 11V7a4 4 0 0 1 8 0v4" /></svg>
                Encrypted at rest
            </span>

            <h1 class="mb-3">Share files securely,<br /><span class="ss-accent">stay in control.</span></h1>

            <p class="text-muted fs-5 mb-4">
                Upload, store and share your files with AES-256 encryption,
                expiring links and password protection.
            </p>

            @if (User.Identity?.IsAuthenticated == true)
            {
                <a asp-controller="File" asp-action="Upload" class="btn btn-primary me-2">Upload a File</a>
                <a asp-controller="File" asp-action="MyFiles" class="btn btn-outline-secondary">View My Files</a>
            }
            else
            {
                <a asp-area="Identity" asp-page="/Account/Register" class="btn btn-primary me-2">Create Account</a>
                <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-outline-secondary">Login</a>
            }
        </div>

        <div class="col-lg-5">
            <div class="ss-card p-4">
                <h5 class="fw-bold mb-1">Security status</h5>
                <p class="text-muted mb-2">Everything is protected</p>

                <div class="ss-status-row"><span>Authentication</span><span class="ss-pill ss-pill-ok">Enabled</span></div>
                <div class="ss-status-row"><span>File Encryption</span><span class="ss-pill ss-pill-ok">AES-256</span></div>
                <div class="ss-status-row"><span>Share Links</span><span class="ss-pill ss-pill-ok">Available</span></div>
            </div>
        </div>
    </div>
</div>

<h4 class="fw-bold mb-4">What you can do</h4>

<div class="row g-4">
    <div class="col-md-4">
        <div class="ss-card p-4 h-100">
            <div class="ss-ico mb-3">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 16V4M6 10l6-6 6 6M4 20h16" /></svg>
            </div>
            <h5 class="fw-bold">Upload Files</h5>
            <p class="text-muted mb-0">Upload supported files and store them securely on the server.</p>
        </div>
    </div>

    <div class="col-md-4">
        <div class="ss-card p-4 h-100">
            <div class="ss-ico mb-3">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="3" /><circle cx="6" cy="12" r="3" /><circle cx="18" cy="19" r="3" /><path d="M8.6 10.5l6.8-4M8.6 13.5l6.8 4" /></svg>
            </div>
            <h5 class="fw-bold">Share Files</h5>
            <p class="text-muted mb-0">Create sharing links with expiry dates, download limits and optional passwords.</p>
        </div>
    </div>

    <div class="col-md-4">
        <div class="ss-card p-4 h-100">
            <div class="ss-ico mb-3">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="8" cy="15" r="4" /><path d="M11 12l9-9M16 7l3 3" /></svg>
            </div>
            <h5 class="fw-bold">Manage Access</h5>
            <p class="text-muted mb-0">View your files, manage sharing links and revoke access whenever required.</p>
        </div>
    </div>
</div>