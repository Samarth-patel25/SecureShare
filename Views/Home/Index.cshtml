@{
    ViewData["Title"] = "Home";
}

<div class="container">

    <div class="row align-items-center py-5">

        <div class="col-lg-7">

            <h1 class="fw-semibold mb-3">
                Secure file sharing made simple
            </h1>

            <p class="text-muted fs-5 mb-4">
                Upload, store and share your files securely.
                SecureShare protects stored files with encryption
                and gives you control over how files are shared.
            </p>

            @if (User.Identity?.IsAuthenticated == true)
            {
                <a asp-controller="File"
                   asp-action="Upload"
                   class="btn btn-primary me-2">
                    Upload a File
                </a>

                <a asp-controller="File"
                   asp-action="MyFiles"
                   class="btn btn-outline-secondary">
                    View My Files
                </a>
            }
            else
            {
                <a asp-area="Identity"
                   asp-page="/Account/Register"
                   class="btn btn-primary me-2">
                    Create Account
                </a>

                <a asp-area="Identity"
                   asp-page="/Account/Login"
                   class="btn btn-outline-secondary">
                    Login
                </a>
            }

        </div>

        <div class="col-lg-5 mt-4 mt-lg-0">

            <div class="simple-info-box">

                <h5 class="fw-semibold mb-3">
                    SecureShare
                </h5>

                <p class="text-muted mb-4">
                    A secure platform for storing and sharing
                    files with controlled access.
                </p>

                <div class="info-row">
                    <span>Authentication</span>
                    <span class="text-success">Enabled</span>
                </div>

                <div class="info-row">
                    <span>File Encryption</span>
                    <span class="text-success">AES-256</span>
                </div>

                <div class="info-row">
                    <span>Share Links</span>
                    <span class="text-success">Available</span>
                </div>

            </div>

        </div>

    </div>


    <div class="border-top pt-5 mt-3">

        <h4 class="fw-semibold mb-4">
            What you can do
        </h4>

        <div class="row g-4">

            <div class="col-md-4">

                <div class="simple-card">

                    <h5 class="fw-semibold">
                        Upload Files
                    </h5>

                    <p class="text-muted mb-0">
                        Upload supported files and store them
                        securely on the server.
                    </p>

                </div>

            </div>

            <div class="col-md-4">

                <div class="simple-card">

                    <h5 class="fw-semibold">
                        Share Files
                    </h5>

                    <p class="text-muted mb-0">
                        Create sharing links with expiry dates,
                        download limits and optional passwords.
                    </p>

                </div>

            </div>

            <div class="col-md-4">

                <div class="simple-card">

                    <h5 class="fw-semibold">
                        Manage Access
                    </h5>

                    <p class="text-muted mb-0">
                        View your files, manage sharing links
                        and revoke access whenever required.
                    </p>

                </div>

            </div>

        </div>

    </div>


    <div class="text-center py-5 mt-4">

        <p class="text-muted mb-0">
            SecureShare — Secure File Sharing Platform
        </p>

    </div>

</div>