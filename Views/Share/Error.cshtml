@model SecureShare.Models.SharePasswordViewModel

@{
    ViewData["Title"] = "Share Link";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">

            <div class="ss-card p-4 p-md-5 text-center">

                <div class="mx-auto mb-4 d-flex align-items-center justify-content-center"
                     style="width:64px;height:64px;border-radius:16px;background:#fdecec;color:#dc3545;font-size:28px;">
                    !
                </div>

                <h2 class="fw-bold mb-2">
                    Unable to access file
                </h2>

                <p class="text-muted mb-4">
                    @Model.ErrorMessage
                </p>

                @if (!string.IsNullOrEmpty(Model.FileName))
                {
                    <div class="border rounded p-3 mb-4 text-start">
                        <div class="text-muted small mb-1">
                            FILE
                        </div>

                        <div class="fw-semibold">
                            @Model.FileName
                        </div>

                        @if (!string.IsNullOrEmpty(Model.ContentType))
                        {
                            <div class="text-muted small mt-1">
                                @Model.ContentType
                            </div>
                        }
                    </div>
                }

                <a asp-controller="Home"
                   asp-action="Index"
                   class="btn btn-outline-secondary">
                    Go to SecureShare
                </a>

            </div>

        </div>
    </div>
</div>