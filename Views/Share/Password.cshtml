@model SecureShare.Models.SharePasswordViewModel

@{
    ViewData["Title"] = "Protected File";
}

<div class="mx-auto" style="max-width: 430px; margin-top: 2rem;">
    <div class="ss-card p-5 text-center">

        <div class="ss-ico mx-auto mb-3" style="width:56px;height:56px;">
            <svg width="24"
                 height="24"
                 viewBox="0 0 24 24"
                 fill="none"
                 stroke="currentColor"
                 stroke-width="2"
                 stroke-linecap="round"
                 stroke-linejoin="round">
                <circle cx="8" cy="15" r="4" />
                <path d="M11 12l9-9M16 7l3 3" />
            </svg>
        </div>

        <h3 class="fw-bold">Protected file</h3>

        <p class="text-muted">
            The owner locked this file with a password.
            Enter it to continue.
        </p>

        @if (!string.IsNullOrEmpty(Model.FileName))
        {
            <div class="border rounded p-3 mb-3 text-start">
                <div class="text-muted small">
                    FILE
                </div>

                <div class="fw-semibold">
                    @Model.FileName
                </div>

                @if (!string.IsNullOrEmpty(Model.ContentType))
                {
                    <div class="text-muted small mt-1">
                        @Model.ContentType
                    </div>
                }
            </div>
        }

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger text-start mb-3">
                <div class="fw-semibold">
                    Unable to access file
                </div>

                <div>
                    @Model.ErrorMessage
                </div>
            </div>
        }

        @if (string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <form asp-controller="Share"
                  asp-action="VerifyPassword"
                  method="post"
                  class="text-start">

                <input type="hidden"
                       asp-for="Token" />

                <div class="mb-3">

                    <label asp-for="Password"
                           class="form-label">
                        Password
                    </label>

                    <input asp-for="Password"
                           class="form-control"
                           type="password"
                           placeholder="Enter password"
                           autocomplete="off" />

                    <span asp-validation-for="Password"
                          class="text-danger">
                    </span>

                </div>

                <button type="submit"
                        class="btn btn-primary w-100 py-2">
                    Unlock file
                </button>

            </form>
        }

    </div>
</div>